{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savewave",
  "version": "1.0.10",
  "identifier": "com.kuberbassi.savewave",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [{ "title": "Savewave", "url": "native.html", "width": 1180, "height": 760, "minWidth": 360, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self' https:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
