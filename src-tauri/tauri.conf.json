{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savewave",
  "version": "2.0.0",
  "identifier": "com.kuberbassi.savewave",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Savewave",
        "url": "native.html",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "backgroundColor": "#111113",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob: 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
