{
  "name": "savewave",
  "version": "1.0.0",
  "description": "Privacy-focused resolver and downloader for supported public video, audio, and image links.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "npx @tailwindcss/cli -i ./public/style.css -o ./public/dist.css --minify",
    "build:js": "babel public/app.jsx --out-file public/app.js",
    "build": "npm run build:css && npm run build:js",
    "test": "vitest run --globals"
  },
  "dependencies": {
    "express": "^4.19.2",
    "undici": "^6.28.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
