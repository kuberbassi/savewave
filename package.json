{
  "name": "savewave",
  "version": "2.0.0",
  "description": "Privacy-focused resolver and downloader for supported public video, audio, and image links.",
  "author": "Kuber Bassi",
  "homepage": "https://savewave.kuberbassi.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuberbassi/savewave.git"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./public/style.css -o ./public/dist.css --minify",
    "build:core": "node scripts/build-core.js",
    "build:js": "babel public/app.jsx --out-file public/app.js && babel public/landing.jsx --out-file public/landing.js",
    "build:vendor": "node scripts/copy-vendor.js",
    "build": "npm run build:vendor && npm run build:css && npm run build:core && npm run build:js",
    "prepare:sidecars": "node scripts/prepare-sidecars.js",
    "tauri:dev": "npx @tauri-apps/cli@2 dev",
    "tauri:build": "npm run prepare:sidecars && npx @tauri-apps/cli@2 build --bundles nsis",
    "android:rust": "powershell -ExecutionPolicy Bypass -File scripts/build-android-rust.ps1",
    "test:rust": "cargo test --workspace",
    "test:spotify-rust": "cargo run --release -p savewave-core --example benchmark_spotify -- 15",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/cli": "^4.3.5",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.2.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
