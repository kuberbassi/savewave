{
  "name": "savewave",
  "version": "1.0.0",
  "description": "Minimal Media & Video Downloader Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "npx @tailwindcss/cli -i ./public/style.css -o ./public/dist.css --minify",
    "build:js": "babel public/app.jsx --out-file public/app.js",
    "build": "npm run build:css && npm run build:js",
    "test": "vitest run --globals"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "framer-motion": "^13.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.18.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "babel-standalone": "^6.26.0",
    "postcss": "^8.5.26",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
